    const START_ERROR_SELECTOR = '.jpo-client-error-message-container.jpo-start';
    const END_ERROR_SELECTOR = '.jpo-client-error-message-container.jpo-end';

    // Variables
    let targetStartValue;
    let targetEndValue;

    // Check if start date is after end date
    function datesAreInvalid(start, end) {
      return new Date(start).getTime() > new Date(end).getTime();
    }

    // Clear all error messages
    function hideDateErrorMessages() {
      $(START_ERROR_SELECTOR).empty();
      $(END_ERROR_SELECTOR).empty();
    }

    // Handle date validation and error display
    function validateDates() {
      if (targetStartValue && targetEndValue && datesAreInvalid(targetStartValue, targetEndValue)) {
        $(START_ERROR_SELECTOR).html(`<span class='error jpo-error'>${escapeHTML(AJS.I18n.getText('rm.jpo.plan.common.baselineStart.error.notBeforeEnd'))}</span>`);
