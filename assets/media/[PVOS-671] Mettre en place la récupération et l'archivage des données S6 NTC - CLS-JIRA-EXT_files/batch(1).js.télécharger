        return false;
      } else {
        hideDateErrorMessages();
        return true;
      }
    }

    // Initialize date fields and validations
    function initTargetDateFields(context) {
      // Add error containers
      $(TARGET_START_SELECTOR, context).each(function() {
        $(this.parentNode).append("<div class='jpo-client-error-message-container jpo-start'/>");
      });

      $(TARGET_END_SELECTOR, context).each(function() {
        $(this.parentNode).append("<div class='jpo-client-error-message-container jpo-end'/>");
      });

      // Get initial values
      targetStartValue = $(TARGET_START_SELECTOR).val();
      targetEndValue = $(TARGET_END_SELECTOR).val();

      // Add change listeners
      $(TARGET_START_SELECTOR).change(function(event) {
        targetStartValue = event.target.value;
        validateDates();
      });

      $(TARGET_END_SELECTOR).change(function(event) {
        targetEndValue = event.target.value;
        validateDates();
      });

      // Initial validation
      validateDates();
    }

    // Register for JIRA content changes
    JIRA.bind(JIRA.Events.NEW_CONTENT_ADDED, (event, context, reason) => {
      if (reason !== JIRA.CONTENT_ADDED_REASON.panelRefreshed) {
        initTargetDateFields(context);
      }
    });
